struct BFContext {
    memory :: [uint8];
    code :: [uint8];
    mem_idx :: uint32;
    code_idx :: uint32;
    return_stack :: [uint32];
}

// Brainfuck instruction characters, in ascending code-point order (member values must increase).
enum BFCommand :: uint8 {
    Plus = '+',
    Comma = ',',
    Minus = '-',
    Period = '.',
    Less = '<',
    Greater = '>',
    LeftBracket = '[',
    RightBracket = ']',
}

extern func readBFCode :: (ctx :: BFContext&) -> void;
extern func runBFCode :: (ctx :: BFContext&) -> void;