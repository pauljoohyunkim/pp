# Wildcard-friendly demo Makefile template
# Copy this file to a demo directory as Makefile and it will work
# without per-demo edits. Binary name is derived from directory name.

ROOT := ../..
PPLANG := $(ROOT)/bin/pplang
PP_STD := $(ROOT)/lib/pp_std

# Sources in this directory
SRCS := $(wildcard *.pp)
PPIS  := $(wildcard *.ppi)

# Target name: directory basename, e.g. 01_fibo -> 01_fibo
TARGET := $(notdir $(CURDIR))

all: $(TARGET)

$(PPLANG):
	$(MAKE) -C $(ROOT)

$(PP_STD)/bin/pp_std.a:
	$(MAKE) -C $(PP_STD)

# Build command with optional PPIs
PPI_FLAGS := $(foreach f,$(PPIS),--ppi $(f))
# Most demos need pp_io; pp_runtime can be added if needed
BASE_PPI := --ppi $(PP_STD)/extern/pp_io.ppi

$(TARGET): $(PPLANG) $(SRCS) $(PPIS) $(PP_STD)/bin/pp_std.a
	$(PPLANG) $(BASE_PPI) $(PPI_FLAGS) $(SRCS) $(PP_STD)/bin/pp_std.a -o $@

clean:
	rm -f $(TARGET)

.PHONY: all clean
