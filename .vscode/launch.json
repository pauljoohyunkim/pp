    "version": "0.2.0",
    "configurations": [
        {
            "name": "pplang pp_test_code.pp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/pplang",
            "args": ["-o", "prog", "pp_test_code.pp", "module_test_code.pp"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build pplang"
        },
